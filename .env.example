# SECRET_KEY, ENC_KEY, MARIADB_PASSWORD, and MARIADB_ROOT_PASSWORD
# should be generated with:
#
# head -c 32 /dev/urandom | base64
#
# Replace the current values with the output of the above command.
# Please use different values for each key, do not just run the command once and paste into every box.

LOCAL_DATA="data" # This should be the full path to your data directory (where you store your files)
SITE_ADMIN="admin@example.com" # Your primary contact email
MAX_FILE_SIZE=1024 # The maximum file size in bytes
SECRET_KEY="asdfghjk" # Your site secret key, used for cookie storage
ENC_KEY="askdljfsadfkljh" # File encryption key
VERSION="" # Custom version number, defaults to most recent git commit hash

# RUN_MODE = "docker" # Uncomment this line if you're running in docker

# Host and Port
HOST=0.0.0.0
PORT=80

# MariaDB Container Variables
MARIADB_USER=user # The database user pasted uses
MARIADB_PASSWORD=change-me-please # The password for the database user
MARIADB_ROOT_PASSWORD=definitely-change-me-please # The root password for the whole database, you really need to change this one.
MARIADB_DATABASE=pasted # The name of the database, default value should be okay

## DOCKER USERS!!! ##
# Do not change the location, nor value of this key, unless you know what you're doing.
## Other Users ##
# You should change this to the correct DB_URI for whichever db you're running. 
# Refer to the SQLACHEMY_DATABASE_URI format if you're unsure on what to do.
DB_URI=mysql+pymysql://${MARIADB_USER}:${MARIADB_PASSWORD}@db:3306/${MARIADB_DATABASE}

# Feel free to remove these comments after filling your values